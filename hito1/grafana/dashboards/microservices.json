{
  "id": null,
  "uid": "microservices-hito1",
  "title": "Package Tracking - Microservices Dashboard",
  "tags": ["microservices", "hito1"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP Requests Rate - All Services",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "Total req/s",
          "datasource": "Prometheus"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
          "legendFormat": "Error %",
          "datasource": "Prometheus"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{"color":"green","value":0},{"color":"red","value":5}] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "count(up{job=~\"user-service|package-service|tracking-service\"} == 1)",
          "legendFormat": "Services Up",
          "datasource": "Prometheus"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color":"red","value":0},{"color":"yellow","value":2},{"color":"green","value":3}] } } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request Latency P95 (ms) — por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"user-service\"}[1m])) by (le)) * 1000",
          "legendFormat": "user-service p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"package-service\"}[1m])) by (le)) * 1000",
          "legendFormat": "package-service p95",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"tracking-service\"}[1m])) by (le)) * 1000",
          "legendFormat": "tracking-service p95",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput — Requests por segundo por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"user-service\"}[1m]))",
          "legendFormat": "user-service",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"package-service\"}[1m]))",
          "legendFormat": "package-service",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"tracking-service\"}[1m]))",
          "legendFormat": "tracking-service",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tasa de Errores por Servicio (req/s con 4xx/5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"user-service\",status=~\"[45]..\"}[1m]))",
          "legendFormat": "user-service errores",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"package-service\",status=~\"[45]..\"}[1m]))",
          "legendFormat": "package-service errores",
          "datasource": "Prometheus"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"tracking-service\",status=~\"[45]..\"}[1m]))",
          "legendFormat": "tracking-service errores",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Estado de Servicios (UP=1)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "up{job=\"user-service\"}",
          "legendFormat": "user-service",
          "datasource": "Prometheus"
        },
        {
          "expr": "up{job=\"package-service\"}",
          "legendFormat": "package-service",
          "datasource": "Prometheus"
        },
        {
          "expr": "up{job=\"tracking-service\"}",
          "legendFormat": "tracking-service",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": { "steps": [{"color":"red","value":0},{"color":"green","value":1}] }
        }
      }
    }
  ]
}
